<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <!-- 洛茜工具箱：Shizuku 相关声明 -->
    <uses-permission android:name="moe.shizuku.api.access.permission.BIND" />

    <queries>
        <package android:name="rikka.shizuku" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".KernelSUApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:directBootAware="true"
        android:fullBackupContent="@xml/backup_rules"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:debuggable="true"
        android:theme="@style/Theme.KernelSU">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KernelSU"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:mimeType="application/zip"
                    android:scheme="content" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data
                    android:host="action"
                    android:scheme="ksu" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data
                    android:host="webui"
                    android:scheme="ksu" />
            </intent-filter>
        </activity>

        <!-- 洛茜工具箱：Compose 版崩溃页（备用） -->
        <activity
            android:name=".ui.crash.CrashActivity"
            android:exported="false"
            android:theme="@style/Theme.KernelSU"
            android:taskAffinity="${applicationId}.crash"
            android:excludeFromRecents="true" />

        <!--
            洛茜工具箱：原生 View 版崩溃页（实际使用）。
            绝对不依赖 Compose / Miuix / 第三方主题资源，
            这样即使 Compose/MiuixTheme 初始化崩了，
            用户也至少能看到堆栈（copy/reboot/close）。
            使用独立 :error_report 进程，避免和崩溃的主进程互相影响。
        -->
        <activity
            android:name=".ui.crash.NativeCrashActivity"
            android:exported="false"
            android:process=":error_report"
            android:taskAffinity="${applicationId}.crash"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

        <activity
            android:name=".ui.webui.WebUIActivity"
            android:autoRemoveFromRecents="true"
            android:configChanges="density|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|locale|layoutDirection|fontScale|keyboard|keyboardHidden"
            android:documentLaunchMode="intoExisting"
            android:exported="false"
            android:taskAffinity="${applicationId}.webui"
            android:theme="@style/Theme.KernelSU.WebUI" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!--
            洛茜工具箱：去掉了 KernelSU 的 magica 相关组件（zygotePreload / MagicaService /
            BootCompletedReceiver），因为它们依赖 Root + ksud 环境，在普通手机上会闪退。
        -->

        <service
            android:name=".ui.util.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            洛茜工具箱：**不声明** rikka.shizuku.ShizukuProvider。
            原因：ShizukuProvider.onCreate 会在 dalvik 层触发 hidden API policy →
            JNI SIGABRT（非 Java Throwable，try-catch 接不住），表现是"点图标直接闪退
            没任何提示"。即便 KernelSUApplication.attachBaseContext 调
            HiddenApiBypass.addHiddenApiExemptions 全豁免，在部分机型 / Android 版本
            上仍然 SIGABRT（例如 Shizuku 的 <clinit> 阶段 native 调用）。
            为了"进 App 是第一优先级"，这里选择不声明 Provider。
            Shizuku SDK 的 Binder 初始化、checkSelfPermission 映射、requestPermission
            弹框等工作改在 Application.onCreate 中用反射手动补齐，
            全部 runCatching 兜底，绝不闪退。见 PermissionManager.ensureShizukuInitialized()。
        -->
    </application>

</manifest>
